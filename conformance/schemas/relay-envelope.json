{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zerodb-relay-envelope",
  "title": "RELAY 0.2.2-draft envelope (draft-1, unfrozen)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "request_id",
    "payload"
  ],
  "properties": {
    "type": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "request_id": {
      "type": "integer",
      "minimum": 0
    },
    "payload": {
      "type": "object"
    },
    "dir": {
      "type": "string",
      "enum": [
        "P→R",
        "R→P"
      ]
    },
    "cbor_hex": {
      "type": "string",
      "pattern": "^[0-9a-f]*$"
    }
  }
}
