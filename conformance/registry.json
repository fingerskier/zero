{
  "registry_version": 1,
  "comment": "Machine-readable version/encoding registry (HX-11, H9 seed). Normative prose: doc/KERNEL.md §1-§2. Both conformance runners load this file; a runner whose constants disagree with it fails.",

  "version_namespaces": {
    "operation_format_version": {
      "authority": "doc/KERNEL.md",
      "current": 1,
      "binding": "persistent; signed and hashed into every operation preimage; a change is a new format generation",
      "status": "draft-1, unfrozen until an explicit Decision Log freeze names a versioned profile"
    },
    "schema_epoch": {
      "authority": "doc/SCHEMA.md §3",
      "current": null,
      "binding": "per-datastore causally ordered sequence, not a global constant; signed into every data operation; IR carries its own schema_ir_format_version (currently 1)",
      "status": "draft-1 (M0b exit 2026-07-18); unfrozen until an explicit Decision Log freeze"
    },
    "snapshot_format_version": {
      "authority": "doc/FRONTIER.md §5",
      "current": 1,
      "binding": "persistent snapshot/checkpoint artifacts only",
      "status": "draft-1 (M0f); unfrozen until an explicit Decision Log freeze"
    },
    "storage_format_version": {
      "authority": "zerodb-storage (M1)",
      "current": null,
      "binding": "local on-disk layout only; MUST NOT appear on the wire or in any preimage",
      "status": "experimental v1 written by LocalStore; unfrozen (no Decision Log freeze)"
    },
    "relay_protocol_version": {
      "authority": "doc/RELAY-SPEC.md",
      "current": 1,
      "binding": "connection negotiation only (HELLO/WELCOME); MUST NOT enter any operation preimage or persistent artifact",
      "status": "draft (RELAY-SPEC 0.2.2-draft; capabilities + dual-root + resume + reject-ack frames)"
    }
  },

  "identifier_encodings": {
    "OpId":        { "bytes": 32, "derivation": "BLAKE3(id-preimage), doc/KERNEL.md §4.4" },
    "PeerId":      { "bytes": 32, "derivation": "BLAKE3(Ed25519 device public key)" },
    "PrincipalId": { "bytes": 32, "derivation": "BLAKE3(Ed25519 principal root public key)" },
    "DatastoreId": { "bytes": 32, "derivation": "BLAKE3(genesis-preimage), doc/KERNEL.md §4.6" },
    "NodeId":      { "bytes": 16, "derivation": "UUIDv7 (RFC 9562)" },
    "EdgeId":      { "bytes": 16, "derivation": "UUIDv7 (RFC 9562)" },
    "GroupId":     { "bytes": 16, "derivation": "UUIDv7 (RFC 9562)" },
    "KeyId":       { "bytes": 16, "derivation": "BLAKE3(group symmetric key), truncated to 16 bytes" },
    "Ed25519PublicKey": { "bytes": 32 },
    "Ed25519Signature": { "bytes": 64 },
    "Blake3Hash":  { "bytes": 32 },
    "HLCTimestamp": { "encoding": "physical_ms u64 + logical u16 + PeerId 32B; field names per doc/KERNEL.md §5" }
  },

  "domain_separation": {
    "schema_ir":    "zerodb-schema-ir-v1",
    "op_id":        "zerodb-op-id-v1",
    "op_signature": "zerodb-op-sig-v1",
    "genesis":      "zerodb-genesis-v1",
    "device_cert":  "zerodb-device-cert-v1",
    "value_aad":    "zerodb-value-aad-v1",
    "value_slot":   "zerodb-value-slot-v1",
    "relay_auth":   "zerodb-relay-auth-v1",
    "relay_handshake": "zerodb-relay-auth-v2",
    "merkle_leaf":  "zerodb-merkle-leaf-v1",
    "merkle_node":  "zerodb-merkle-node-v1",
    "merkle_empty": "zerodb-merkle-empty-v1",
    "snapshot":     "zerodb-snapshot-v1"
  },


  "relay_capabilities": {
    "authority": "doc/RELAY-SPEC.md §4.1.1",
    "tokens": ["dual-root", "merkle-walk-v1", "reject-ack", "resume-cursor"],
    "status": "draft (RELAY-SPEC 0.2.2-draft)"
  },

  "relay_wire": {
    "comment": "H9 machine-readable RELAY 0.2.2-draft definition. Both runners load this; schemas/ is generated from it. Draft-1 / unfrozen — not a format freeze.",
    "authority": "doc/RELAY-SPEC.md",
    "status": "draft (RELAY-SPEC 0.2.2-draft; unfrozen)",
    "protocol_version": 1,
    "relay_level": 2,
    "domain_handshake": "zerodb-relay-auth-v2",
    "domain_handshake_v1": "zerodb-relay-auth-v1",
    "byte_fields": [
      "peer_id",
      "public_key",
      "nonce",
      "signature",
      "validated_root",
      "accepted_root",
      "op_id",
      "author",
      "hash",
      "left",
      "right",
      "target",
      "sender"
    ],
    "welcome_limits": {
      "comment": "Advertised experimental WELCOME defaults (RELAY-SPEC §8.1). Distinct from format `limits` (KERNEL/O6).",
      "max_payload_bytes": 1048576,
      "max_batch_ops": 64,
      "max_batch_bytes": 16777216,
      "max_subscriptions": 64,
      "ops_per_second": 100,
      "bytes_per_second": 10485760,
      "max_connections_per_peer": 3
    },
    "messages": {
      "HELLO": { "type": 1, "dir": "P→R", "required": ["peer_id", "public_key", "protocol_version", "capabilities"], "responses": ["CHALLENGE", "ERROR"] },
      "CHALLENGE": { "type": 2, "dir": "R→P", "required": ["nonce"] },
      "AUTH": { "type": 3, "dir": "P→R", "required": ["signature"], "responses": ["WELCOME", "ERROR"] },
      "WELCOME": { "type": 4, "dir": "R→P", "required": ["protocol_version", "relay_level", "capabilities", "limits"] },
      "SUBSCRIBE": { "type": 16, "dir": "P→R", "required": ["datastores", "connectable"], "responses": ["SUBSCRIBED", "ERROR"] },
      "SUBSCRIBED": { "type": 17, "dir": "R→P", "required": ["datastores"] },
      "UNSUBSCRIBE": { "type": 18, "dir": "P→R", "required": ["datastores"] },
      "SYNC_REQUEST": { "type": 32, "dir": null, "required": ["datastore"], "responses": ["SYNC_RESPONSE"] },
      "SYNC_RESPONSE": { "type": 33, "dir": null, "required": ["datastore"] },
      "DELTA_REQUEST": { "type": 34, "dir": null, "required": ["datastore", "op_ids"], "responses": ["DELTA_BATCH"] },
      "DELTA_BATCH": { "type": 35, "dir": null, "required": ["datastore", "operations", "remaining"] },
      "SYNC_ACK": { "type": 36, "dir": null, "required": ["datastore"] },
      "MERKLE_NODE_REQUEST": { "type": 37, "dir": null, "required": ["datastore", "level", "index"], "responses": ["MERKLE_NODE_RESPONSE"] },
      "MERKLE_NODE_RESPONSE": { "type": 38, "dir": null, "required": ["datastore", "level", "index", "hash", "left", "right"] },
      "MERKLE_LEAF_REQUEST": { "type": 39, "dir": null, "required": ["datastore", "leaf_index"], "responses": ["MERKLE_LEAF_RESPONSE"] },
      "MERKLE_LEAF_RESPONSE": { "type": 40, "dir": null, "required": ["datastore", "leaf_index", "bucket_index", "op_ids"] },
      "OPS": { "type": 48, "dir": null, "required": ["datastore", "operations"], "responses": ["OP_ACK", "ERROR"] },
      "OP_ACK": { "type": 49, "dir": "R→P", "required": ["outcomes"] },
      "PEER_LIST_REQUEST": { "type": 64, "dir": "P→R", "required": ["datastore"], "responses": ["PEER_LIST_RESPONSE"] },
      "PEER_LIST_RESPONSE": { "type": 65, "dir": "R→P", "required": ["datastore", "peers"] },
      "SIGNAL": { "type": 66, "dir": null, "required": ["payload"] },
      "PING": { "type": 80, "dir": null, "required": ["timestamp"], "responses": ["PONG"] },
      "PONG": { "type": 81, "dir": null, "required": ["timestamp"] },
      "THROTTLE": { "type": 82, "dir": "R→P", "required": ["scope", "retry_after_ms"] },
      "GOODBYE": { "type": 254, "dir": null, "required": ["reason"] },
      "ERROR": { "type": 255, "dir": null, "required": ["code", "message", "fatal"] }
    },
    "errors": {
      "AUTH_FAILED": { "code": 513, "fatal": true },
      "UNSIGNED_OP": { "code": 769, "fatal": false },
      "CLOCK_DRIFT": { "code": 770, "fatal": false },
      "PAYLOAD_TOO_LARGE": { "code": 771, "fatal": false },
      "RATE_EXCEEDED": { "code": 772, "fatal": false },
      "TOO_MANY_SUBS": { "code": 773, "fatal": false }
    },
    "op_ack_reject_reasons": ["DECODE", "SIG", "AUTHZ"]
  },

  "h6_profile": {
    "comment": "H6 protocol close-candidate contract. Named fixtures in vectors/required/h6/. Live WS fanout stays in signal_ws / signal-ws tests. TURN/NAT is infra, not this profile. H6 is not closed; steward confirms. Not M4a complete.",
    "authority": "doc/RELAY-SPEC.md, zerodb-core/src/handshake.rs, conformance/ts/webrtc/",
    "status": "draft (H6 close candidate; not H6 closed; not M4a complete)",
    "admission_error": "AUTH_WRONG_DATASTORE",
    "auth_domain": "zerodb-relay-auth-v2",
    "fixtures": [
      "H6-SIGNAL-001",
      "H6-SIGNAL-002",
      "H6-ROLE-001",
      "H6-AUTH-001",
      "H6-AUTH-002",
      "H6-WELCOME-001",
      "H6-ADMIT-001",
      "H6-ADMIT-002",
      "H6-RESUME-001"
    ]
  },

  "peer_rejects": {
    "comment": "Named peer-side ingest outcomes (AUTH.md §4 / KERNEL §5 / SCHEMA.md §3). Distinct from relay OP_ACK reasons and ERROR codes.",
    "authority": "doc/AUTH.md, doc/KERNEL.md, doc/SCHEMA.md",
    "reasons": [
      "AUTH_SIG_INVALID",
      "AUTH_WRONG_DATASTORE",
      "CLOCK_DRIFT",
      "EPOCH_UNKNOWN",
      "APPLY_INVALID"
    ],
    "max_drift_ms": 60000
  },

  "merkle": {
    "authority": "doc/MERKLE.md",
    "merkle_format_version": 1,
    "bucket_width_ms": 60000,
    "status": "draft-1 (M0c exit 2026-07-18); unfrozen until an explicit Decision Log freeze"
  },



  "limits": {
    "status": "provisional (ISSUES O6; ratified with the O6 fixture set)",
    "max_operation_bytes": 65536,
    "max_batch_bytes": 262144,
    "max_batch_ops": 512,
    "max_cbor_depth": 16,
    "max_deps_per_op": 64
  },

  "crdt_tags": {
    "0": "lww", "1": "gcounter", "2": "pncounter", "3": "orset", "4": "flag",
    "5": "mvregister (reserved, M2)", "6": "lwwmap (reserved, M2)", "7": "rga (reserved, M2)"
  },

  "value_type_tags": {
    "0": "any-scalar", "1": "bool", "2": "int", "3": "float64", "4": "text", "5": "bytes"
  },

  "blob_codecs": {
    "0": "raw",
    "comment": "BlobRef codec registry (DQ-6). v0.1 implementations parse BlobRef and reject with BLOB_UNSUPPORTED."
  }
}
